from pathlib import Path
import argparse
import numpy as np
import cv2

def find_boundary_points(binary_image):
    """
    Trouve UN SEUL point rouge par ligne:
    1. Si les 2000 premiers pixels ne contiennent AUCUN blanc → premier pixel blanc de la ligne
    2. Sinon → dernier pixel blanc qui n'a PAS de blanc dans les 2000 pixels suivants
    """
    h, w = binary_image.shape
    boundary_points = []
    
    for y in range(h):
        row = binary_image[y, :]
        # Trouver tous les pixels blancs (255)
        white_pixels = np.where(row == 255)[0]
        
        if len(white_pixels) == 0:
            continue  # Pas de pixel blanc sur cette ligne
        
        # Règle 1: Si aucun blanc dans les 2000 premiers pixels
        first_white = white_pixels[0]
        if first_white >= 2000:
            # Prendre le premier pixel blanc
            boundary_points.append((first_white, y))
            continue
        
        # Règle 2: Chercher le dernier pixel blanc sans blanc dans les 2000 suivants
        valid_point = None
        for x in white_pixels:
            # Vérifier les 2000 pixels suivants
            has_white_after = False
            for offset in range(1, 2001):
                next_x = x + offset
                if next_x < w:
                    if row[next_x] == 255:
                        has_white_after = True
                        break
            
            # Si aucun blanc dans les 2000 suivants, c'est un candidat valide
            if not has_white_after:
                valid_point = (x, y)  # Garder le dernier trouvé
        
        # Ajouter le point valide s'il existe
        if valid_point is not None:
            boundary_points.append(valid_point)
    
    return boundary_points

def visualize_boundary(original_gray, binary_image, boundary_points):
    """
    Crée une visualisation avec les points de frontière en rouge.
    """
    # Convertir en BGR pour afficher en couleur
    vis = cv2.cvtColor(original_gray, cv2.COLOR_GRAY2BGR)
    
    # Dessiner les points de frontière en rouge
    for (x, y) in boundary_points:
        cv2.circle(vis, (x, y), 2, (0, 0, 255), -1)  # Rouge en BGR
    
    return vis

def draw_smooth_curve(original_gray, boundary_points, window_size=50):
    """
    Dessine une courbe lisse basée sur la tendance moyenne des points rouges.
    Utilise une moyenne mobile pour représenter la direction de densité des points.
    window_size: nombre de points pour calculer la moyenne mobile
    """
    if len(boundary_points) < 2:
        return cv2.cvtColor(original_gray, cv2.COLOR_GRAY2BGR)
    
    # Convertir en BGR
    vis = cv2.cvtColor(original_gray, cv2.COLOR_GRAY2BGR)
    
    # Convertir les points en array numpy
    points = np.array(boundary_points, dtype=np.float32)
    
    # Trier par y (ligne) pour s'assurer de la continuité
    sorted_indices = np.argsort(points[:, 1])
    points = points[sorted_indices]
    
    # Ajuster la taille de fenêtre si nécessaire
    if len(points) < window_size:
        window_size = max(3, len(points) // 3)
    
    # Calculer la moyenne mobile pour lisser la courbe
    smoothed_points = []
    for i in range(len(points)):
        # Fenêtre centrée autour du point i
        start = max(0, i - window_size // 2)
        end = min(len(points), i + window_size // 2 + 1)
        
        # Moyenne des coordonnées x dans la fenêtre (tendance directionnelle)
        window_points = points[start:end]
        avg_x = np.mean(window_points[:, 0])
        y = points[i, 1]  # Garder le y original
        
        smoothed_points.append([avg_x, y])
    
    smoothed_points = np.array(smoothed_points, dtype=np.int32)
    
    # Dessiner la polyligne lissée (tendance moyenne)
    cv2.polylines(vis, [smoothed_points], isClosed=False, color=(0, 0, 255), thickness=3, lineType=cv2.LINE_AA)
    
    return vis

def threshold_image(gray, threshold=150):
    """
    Applique un seuillage simple:
    - <= threshold (150) : noir complet (0)
    - > threshold (150) : blanc complet (255)
    """
    result = np.zeros_like(gray)
    
    # Pixels > threshold → blanc
    result[gray > threshold] = 255
    
    # Pixels <= threshold → noir (déjà à 0)
    
    return result

def process_image(image_path, threshold=150, window_size=50, show=True, save=False):
    """
    Charge l'image, applique le seuillage et affiche/sauvegarde le résultat.
    """
    # Charger en niveaux de gris
    gray = cv2.imread(str(image_path), cv2.IMREAD_GRAYSCALE)
    
    if gray is None:
        raise ValueError(f"Impossible de charger l'image: {image_path}")
    
    # Appliquer le seuillage
    result = threshold_image(gray, threshold=threshold)
    
    # Trouver les points de frontière
    boundary_points = find_boundary_points(result)
    
    # Créer la visualisation avec points rouges
    vis_boundary = visualize_boundary(gray, result, boundary_points)
    
    # Créer la visualisation avec courbe lisse (tendance moyenne)
    vis_smooth = draw_smooth_curve(gray, boundary_points, window_size=window_size)
    
    # Statistiques pour debug
    n_black = np.sum(result == 0)
    n_white = np.sum(result == 255)
    total = gray.size
    
    print(f"\n=== Statistiques ===")
    print(f"Pixels noirs (≤{threshold}): {n_black:7d} ({100*n_black/total:5.2f}%)")
    print(f"Pixels blancs (>{threshold}):  {n_white:7d} ({100*n_white/total:5.2f}%)")
    print(f"Points de frontière:        {len(boundary_points):7d}")
    print(f"Total:                      {total:7d}")
    
    # Sauvegarder si demandé
    if save:
        out_path = Path(image_path).with_name(Path(image_path).stem + f"_threshold_{threshold}.png")
        cv2.imwrite(str(out_path), result)
        print(f"\nImage seuillée sauvegardée: {out_path}")
        
        out_path_boundary = Path(image_path).with_name(Path(image_path).stem + f"_boundary_{threshold}.png")
        cv2.imwrite(str(out_path_boundary), vis_boundary)
        print(f"Image avec frontière sauvegardée: {out_path_boundary}")
        
        out_path_smooth = Path(image_path).with_name(Path(image_path).stem + f"_smooth_{threshold}.png")
        cv2.imwrite(str(out_path_smooth), vis_smooth)
        print(f"Image avec courbe lisse sauvegardée: {out_path_smooth}")
    
    # Afficher si demandé
    if show:
        # Créer une visualisation à 4 volets
        h, w = gray.shape
        comparison = np.zeros((h, w*4, 3), dtype=np.uint8)
        
        # Image originale (convertie en BGR)
        comparison[:, :w] = cv2.cvtColor(gray, cv2.COLOR_GRAY2BGR)
        
        # Image seuillée (convertie en BGR)
        comparison[:, w:2*w] = cv2.cvtColor(result, cv2.COLOR_GRAY2BGR)
        
        # Image avec points de frontière
        comparison[:, 2*w:3*w] = vis_boundary
        
        # Image avec courbe lisse
        comparison[:, 3*w:] = vis_smooth
        
        cv2.imshow("Original | Seuillage | Points rouges | Courbe lisse", comparison)
        print("\nAppuyez sur une touche pour fermer...")
        cv2.waitKey(0)
        cv2.destroyAllWindows()
    
    return result, boundary_points

# --- CLI ---
if __name__ == "__main__":
    p = argparse.ArgumentParser(
        description="Seuillage binaire avec détection de frontière (seuil 2000) et courbe lissée"
    )
    p.add_argument("--img", type=str, default=None, help="Chemin de l'image")
    p.add_argument("--threshold", type=int, default=150, help="Valeur de seuil (défaut: 150)")
    p.add_argument("--window-size", type=int, default=50, help="Taille de fenêtre pour lissage courbe (défaut: 50)")
    p.add_argument("--no-show", action="store_true", help="Ne pas afficher l'image")
    p.add_argument("--save", action="store_true", help="Sauvegarder l'image résultat")
    args = p.parse_args()
    
    # Trouver l'image
    root = Path(__file__).resolve().parents[1]
    if args.img:
        img_path = (root / args.img) if not Path(args.img).is_absolute() else Path(args.img)
        if not img_path.exists():
            raise SystemExit(f"Image introuvable: {img_path}")
    else:
        cands = list((root / "images_test").rglob("edge_579.png"))
        if not cands:
            raise SystemExit("Aucune image PNG trouvée sous images_test/")
        img_path = cands[0]
        print(f"Utilisation de: {img_path}")
    
    # Traiter l'image
    result, boundary_points = process_image(
        img_path, 
        threshold=args.threshold,
        window_size=args.window_size,
        show=not args.no_show,
        save=args.save
    )





