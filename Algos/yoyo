# run_mean30x30x30_then_bilat_sub40_morph_then_thresh.py
import cv2, sys
import numpy as np
from pathlib import Path

# ---------- helpers ----------
def find_image():
    root = Path(__file__).resolve().parents[1]  # adapte au besoin
    pats = [
        "images_test/contrastenette_max_above_0.2_t13s.png",
        "**/contrastenette_max_above_0.2_t13s.png",
    ]
    for pat in pats:
        hits = list(root.glob(pat))
        if hits:
            return hits[0]
    sys.exit("Image introuvable (vérifie le dossier).")

def box_multi(img, ksize=(30,30), passes=30, border=cv2.BORDER_REPLICATE):
    out = img
    for _ in range(int(passes)):
        out = cv2.blur(out, ksize, borderType=border)
    return out

def bilateral(img, d=0, sigmaColor=25, sigmaSpace=5, passes=1):
    out = img
    for _ in range(int(passes)):
        out = cv2.bilateralFilter(out, d=d, sigmaColor=sigmaColor, sigmaSpace=sigmaSpace)
    return out

def to_gray(u):
    if u.ndim == 2: return u
    return cv2.cvtColor(u[:,:,:3] if u.shape[2]==4 else u, cv2.COLOR_BGR2GRAY)

# ---------- pipeline ----------
if __name__ == "__main__":
    # Réglages (change-les au besoin)
    mean_passes   = 30             # ← moyenneur appliqué 30 fois
    mean_ksize    = (30,30)
    bil_passes    = 1
    bil_sig_color = 25
    bil_sig_space = 5
    subtract_val  = 40
    morph_k       = 5              # noyau morpho k×k
    morph_iters   = 1
    thr           = 70             # >70 → noir (binaire inversé)

    # 1) lecture
    p = find_image()
    print("Image:", p)
    img = cv2.imread(str(p), cv2.IMREAD_UNCHANGED)
    if img is None: sys.exit("Lecture impossible.")

    # 2) moyenneur 30×30 répété 30 fois
    tmp = box_multi(img, ksize=mean_ksize, passes=mean_passes)

    # 3) bilatéral (sur BGR si présent)
    tmp = bilateral(tmp, d=0, sigmaColor=bil_sig_color, sigmaSpace=bil_sig_space, passes=bil_passes)

    # 4) gris 8 bits
    gray = to_gray(tmp)
    if gray.dtype != np.uint8:
        gray = cv2.normalize(gray, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

    # 5) soustraction de 40 (clip auto à 0)
    gray = cv2.subtract(gray, subtract_val)

    # 6) fermeture → ouverture → fermeture → ouverture → fermeture
    kernel = np.ones((morph_k, morph_k), np.uint8)
    gray = cv2.morphologyEx(gray, cv2.MORPH_CLOSE,  kernel, iterations=morph_iters)
    gray = cv2.morphologyEx(gray, cv2.MORPH_OPEN,   kernel, iterations=morph_iters)
    gray = cv2.morphologyEx(gray, cv2.MORPH_CLOSE,  kernel, iterations=morph_iters)
    gray = cv2.morphologyEx(gray, cv2.MORPH_OPEN,   kernel, iterations=morph_iters)
    gray = cv2.morphologyEx(gray, cv2.MORPH_CLOSE,  kernel, iterations=morph_iters)

    # 7) binarisation : >70 → 0 (noir), ≤70 → 255 (blanc)
    _, bw = cv2.threshold(gray, thr, 255, cv2.THRESH_BINARY_INV)

    # 8) sauvegardes
    out_dir = p.parent / "outputs"
    out_dir.mkdir(exist_ok=True)
    base = p.stem
    inter1 = out_dir / f"{base}_mean{mean_ksize[0]}x{mean_ksize[1]}_{mean_passes}passes.png"
    inter2 = out_dir / f"{base}_bilat_sc{bil_sig_color}_ss{bil_sig_space}_p{bil_passes}.png"
    inter3 = out_dir / f"{base}_sub{subtract_val}_morph_COCOPCO.png"  # C O C O C
    final  = out_dir / f"{base}_thr{thr}_binINV.png"

    cv2.imwrite(str(inter1), box_multi(img, mean_ksize, mean_passes))  # pour inspection
    cv2.imwrite(str(inter2), tmp)                                      # après bilatéral
    cv2.imwrite(str(inter3), gray)                                     # après morpho
    cv2.imwrite(str(final),  bw)                                       # binaire final

    print("Écrit :", final)






































