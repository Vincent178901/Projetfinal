# ================================================
#  DÉTECTEUR D'ANGLE DE FIBRE – VERSION ANTI-SATURATION 2025
#  Fonctionne même si l'image est blanche comme un flash de soudeur
# ================================================

import cv2
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

# ========================================
#  CHEMINS (à toi de vérifier que edge_1.png est bien là)
# ========================================
script_dir = Path(__file__).resolve().parent
project_root = script_dir.parent
in_dir = project_root / "images_test" / "Tests"
img_path = in_dir / "edge_1.png"

if not img_path.exists():
    print(f"Image manquante → {img_path}")
    exit()

print(f"Image chargée → {img_path.name}")

# ========================================
#  CHARGEMENT + DÉSATURATION DE COMPÉTITION
# ========================================
img_raw = cv2.imread(str(img_path), cv2.IMREAD_GRAYSCALE)
if img_raw is None:
    print("Impossible de lire l'image.")
    exit()

h, w = img_raw.shape
print(f"Dimensions : {w} × {h}")

# ──────── LA SAUCE SECRÈTE ANTI-BLANC-CRAMÉ ────────
print("Désaturation agressive en cours... (Top-Hat + Gamma violent)")

# 1. Top-Hat ultra-puissant pour virer le halo blanc géant
kernel_size = 91                    # 81-111 → plus gros = plus fort contre la saturation
kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (kernel_size, kernel_size))
tophat = cv2.morphologyEx(img_raw, cv2.MORPH_TOPHAT, kernel)
img_clean = cv2.subtract(img_raw, tophat)

# 2. Gamma très bas pour écraser les restes de blanc (0.25 = nucléaire)
gamma = 0.25
lut = np.array([((i / 255.0) ** (1 / gamma)) * 255 for i in np.arange(256)]).astype("uint8")
img_clean = cv2.LUT(img_clean, lut)

# 3. Normalisation finale propre
img_norm = cv2.normalize(img_clean, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

# Optionnel : léger blur pour enlever les artefacts de Top-Hat
img_norm = cv2.GaussianBlur(img_norm, (3, 3), 0)

print("Saturation détruite. Fibre retrouvée.")

# ========================================
#  PRÉTRAITEMENT ROBUSTE (simplifié grâce à la désaturation)
# ========================================
# Soustraction fond doux
bg = cv2.morphologyEx(img_norm, cv2.MORPH_OPEN,
                      cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (35, 35)))
subtract_img = cv2.subtract(img_norm, bg)

# Seuillage (on peut se permettre d'être plus sévère maintenant)
binary = np.zeros_like(subtract_img)
binary[subtract_img > 12] = 255

# Nettoyage du bruit
for _ in range(3):
    binary = cv2.medianBlur(binary, 11)

# Refermer les petits trous
closing_img = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, np.ones((30, 30), np.uint8))

print("Prétraitement terminé – bordure nickel")

# ========================================
#  CONTOUR & FIT PARABOLIQUE
# ========================================
contours, _ = cv2.findContours(closing_img, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_NONE)
if not contours:
    print("Aucun contour trouvé – augmente le gamma ou baisse le kernel_size")
    exit()

contour = max(contours, key=cv2.contourArea)[:, 0, :]
x_c, y_c = contour[:, 0], contour[:, 1]

# Tri + nettoyage bordures
idx = np.argsort(x_c)
x_sort, y_sort = x_c[idx], y_c[idx]
margin = 40
mask = (x_sort > margin) & (x_sort < w - margin) & (y_sort > margin) & (y_sort < h - margin)
x_fit, y_fit = x_sort[mask], y_sort[mask]

if len(x_fit) < 20:
    print("Pas assez de points – l'image est trop cramée ?")
    exit()

# Fit parabole
poly = np.poly1d(np.polyfit(x_fit, y_fit, 2))

# Courbe lisse 1000 pts
x_dense = np.linspace(x_fit.min(), x_fit.max(), 1000)
y_dense = poly(x_dense).astype(int)
curve_pts = np.column_stack((x_dense.astype(int), y_dense))

# Point médian le plus proche du centre de masse
center_mass = np.mean(contour, axis=0).astype(int)
dists = np.linalg.norm(curve_pts - center_mass, axis=1)
mid_idx = np.argmin(dists)
mid_x, mid_y = x_dense[mid_idx], y_dense[mid_idx]
mid_pt = (int(mid_x), int(mid_y))

# ========================================
#  TANGENTE & NORMALE INTÉRIEURE
# ========================================
deriv = np.polyder(poly)
slope = deriv(mid_x)
angle_tan = np.arctan(slope)
dx_t, dy_t = np.cos(angle_tan), np.sin(angle_tan)

# Deux normales possibles
n1 = np.array([-dy_t, dx_t])
n2 = np.array([dy_t, -dx_t])

# Test laquelle pointe à l'intérieur
p1 = np.array(mid_pt) + 80 * n1
p2 = np.array(mid_pt) + 80 * n2
p1f = tuple(np.clip(p1, [0,0], [w-1,h-1]).astype(np.float32))
p2f = tuple(np.clip(p2, [0,0], [w-1,h-1]).astype(np.float32))

inside1 = cv2.pointPolygonTest(contour, p1f, False)
inside2 = cv2.pointPolygonTest(contour, p2f, False)

if inside1 > 0:
    dx_n, dy_n = n1
elif inside2 > 0:
    dx_n, dy_n = n2
else:
    # Fallback robuste
    def count_white(a, b):
        line = np.zeros_like(closing_img)
        cv2.line(line, a, b, 1, 4)
        return np.sum(line & closing_img > 0)
    dx_n, dy_n = n1 if count_white(mid_pt, tuple(p1.astype(int))) > count_white(mid_pt, tuple(p2.astype(int))) else n2

# Normalisation vecteur
norm = np.hypot(dx_n, dy_n)
if norm > 0:
    dx_n, dy_n = dx_n / norm, dy_n / norm

# ========================================
#  ANGLE DEPUIS HORIZONTALE DROITE (3h)
# ========================================
angle_ccw_from_horizontal = np.degrees(np.arctan2(-dy_n, dx_n))
if angle_ccw_from_horizontal < 0:
    angle_ccw_from_horizontal += 360

display_angle = round(angle_ccw_from_horizontal, 2)

print(f"\nANGLE MESURÉ DEPUIS L'HORIZONTALE (3h) → {display_angle}°")

# ========================================
#  VISUEL ÉPIQUE
# ========================================
overlay = cv2.cvtColor(img_raw, cv2.COLOR_GRAY2BGR)

# Contour jaune
cv2.drawContours(overlay, [contour], -1, (0, 255, 255), 3)

# Parabole rouge
cv2.polylines(overlay, [curve_pts], False, (0, 0, 255), 4)

# Point central
cv2.circle(overlay, mid_pt, 18, (0, 0, 255), -1)
cv2.circle(overlay, mid_pt, 18, (255, 255, 255), 4)

# Tangente bleue
cv2.line(overlay, (int(mid_x - 80*dx_t), int(mid_y - 80*dy_t)),
         (int(mid_x + 80*dx_t), int(mid_y + 80*dy_t)), (255, 100, 0), 6)

# Normale intérieure (flèche rouge → bleue)
cv2.arrowedLine(overlay, mid_pt,
                (int(mid_x + 160*dx_n), int(mid_y + 160*dy_n)),
                (200, 0, 0), 10, tipLength=0.2)

# Référence 0° verte
for i in range(0, 120, 12):
    cv2.line(overlay, (mid_pt[0] + i, mid_pt[1]), (mid_pt[0] + i + 8, mid_pt[1]), (0, 255, 0), 5)
cv2.putText(overlay, "0°", (mid_pt[0] + 130, mid_pt[1] + 10),
            cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 3)

# Arc vert + texte gros
arc_radius = 80
cv2.ellipse(overlay, mid_pt, (arc_radius, arc_radius), 0, -display_angle, 0, (0, 255, 0), 8)
cv2.putText(overlay, f"{display_angle}°", (mid_pt[0] - 60, mid_pt[1] - 100),
            cv2.FONT_HERSHEY_SIMPLEX, 2.2, (0, 255, 0), 6)

# ========================================
#  RAPPORT FINAL
# ========================================
plt.figure(figsize=(18, 10), facecolor='black')
plt.suptitle(f"ANGLE = {display_angle}° – SATURATION DÉTRUITE, FIBRE SAUVÉE",
             fontsize=28, color='lime', weight='bold', y=0.95)

imgs = [
    ("01 – Image brute (cramée)", img_raw),
    ("02 – Après Top-Hat + Gamma", img_norm),
    ("03 – Soustraction fond", subtract_img),
    ("04 – Binaire", binary),
    ("05 – Fermeture", closing_img),
    ("06 – RÉSULTAT FINAL", overlay),
]

for i, (title, img) in enumerate(imgs):
    plt.subplot(2, 3, i+1)
    if len(img.shape) == 3:
        plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    else:
        plt.imshow(img, cmap='gray', vmin=0, vmax=255)
    plt.title(title, fontsize=16, color='cyan', pad=20)
    plt.axis('off')

plt.tight_layout()
plt.show()

print(f"\nMISSION ACCOMPLIE, TABARNAK !")
print(f"Angle mesuré avec image saturée → {display_angle}°")
print("Va donc checker ton rapport, c’est beau en ostie.")